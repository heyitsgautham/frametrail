# Copy to apps/web/.env.local, which git ignores.
# Every variable is optional, and the app runs with this file absent.
# Leave a value empty to keep the neutral default shown after it.
# `pnpm check:names` fails if any NEXT_PUBLIC_ value or PRIVATE_TERMS entry appears in a tracked file.

# Product name in the sidebar, the page titles and the title card. Default FrameTrail.
NEXT_PUBLIC_PRODUCT=
# Problem statement ID, shown before the organisation line. Default empty.
NEXT_PUBLIC_PS=
# Short event label. No screen shows it yet, and `pnpm check:names` still keeps it out of tracked files.
NEXT_PUBLIC_EVENT=
# Team line on the title card. Default empty.
NEXT_PUBLIC_TEAM=
# Tagline on the title card. Default "Every frame, traced to its source bytes".
NEXT_PUBLIC_TAGLINE=

# Case file the screens and the recording storyboard read. Default data/demo/derived/case.json.
# `frametrail analyse` writes the default path, so set this only to show a case.json kept elsewhere.
FT_CASE=

# Lowest level the server's JSON log on stdout keeps: trace, debug, info, warn, error or fatal. Default info.
LOG_LEVEL=

# More names for `pnpm check:names` to keep out of tracked files, separated by "|".
PRIVATE_TERMS=
# How the voiceover pronounces the product name, used by `pnpm voiceover`. Default empty.
PRODUCT_SAY=

# FT_URL is read from the shell, not from this file.
# It points `pnpm test:e2e` at a running build, and defaults to http://localhost:3150.
